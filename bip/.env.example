# Battery Intelligence Platform environment reference.
#
# Copy values into `.env.development` / `.env.production` as needed.
# Frontend variables (VITE_*) are loaded by Vite for the matching mode.
# Backend variables (BIP_*) are loaded by the FastAPI app (pydantic-settings).

# --- Frontend ---

# Base path all API requests are sent to. Kept relative so Vite can proxy
# `/api` to the API in development. Override in production if the API is
# served from a different origin (e.g. https://api.example.com/api).
VITE_BIP_API_BASE_URL=/api

# Target used by the Vite dev-server proxy for `/api` requests.
VITE_BIP_API_PROXY_TARGET=http://localhost:8100

# --- Backend ---

BIP_APP_NAME=Battery Intelligence Platform API
BIP_API_VERSION=0.3.0
BIP_ENVIRONMENT=development
# Comma-separated list of allowed browser origins.
BIP_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- Database (read-only) ---

# The API connects as `bip_reader` which has SELECT-only grants; it never
# writes, creates or alters anything. Override in production deployments.
BIP_DB_HOST=localhost
BIP_DB_PORT=5432
BIP_DB_NAME=bdr_dashboard
BIP_DB_USER=bip_reader
BIP_DB_PASSWORD=reader_pass

# Live data freshness window in seconds (aligned with the BIC spec value).
BIP_FRESHNESS_WINDOW_SECONDS=60

# --- Scripts ---

# Base URL used by `npm run health:api`.
BIP_API_URL=http://127.0.0.1:8100
