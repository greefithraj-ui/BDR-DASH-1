{
  "name": "battery-intelligence-platform",
  "version": "0.3.0",
  "private": true,
  "description": "Battery Intelligence Platform: live operational dashboards, analytics, and reports over the battery database.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload --host 127.0.0.1 --port 8100",
    "health:api": "python scripts/check_health.py"
  },
  "engines": {
    "node": ">=20",
    "python": ">=3.11"
  }
}
